# === Database ===
DB__URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rahasya

# === Redis ===
REDIS__URL=redis://localhost:6379/0
CELERY__BROKER_URL=redis://localhost:6379/1
CELERY__RESULT_BACKEND=redis://localhost:6379/2

# === API Keys (all optional) ===
API_KEYS__HIBP=
API_KEYS__INTELX=
API_KEYS__DEHASHED=
API_KEYS__LEAKLOOKUP=
API_KEYS__SHODAN=
API_KEYS__VIRUSTOTAL=

# === Neo4j (optional) ===
NEO4J__ENABLED=false
NEO4J__URI=bolt://localhost:7687
NEO4J__USER=neo4j
NEO4J__PASSWORD=password

# === Tor (optional) ===
TOR__ENABLED=false
TOR__SOCKS_PORT=9050
TOR__CONTROL_PORT=9051
TOR__PASSWORD=

# === Scan Limits ===
SCAN__MAX_DEPTH=3
SCAN__MAX_ENTITIES=500
SCAN__MAX_TIME_MINUTES=30

# === Application ===
LOG_LEVEL=INFO
ENVIRONMENT=development
DEBUG=false
