DB__URL=postgresql+asyncpg://postgres:postgres@postgres:5432/rahasya
REDIS__URL=redis://redis:6379/0
REDIS__PUBSUB_ENABLED=true
CELERY__BROKER_URL=redis://redis:6379/1
CELERY__RESULT_BACKEND=redis://redis:6379/2
CELERY__ENABLED=true
NEO4J__URI=bolt://neo4j:7687
NEO4J__USER=neo4j
NEO4J__PASSWORD=change-me-now
NEO4J__ENABLED=false
TOR__ENABLED=true
TOR__SOCKS_HOST=tor
TOR__SOCKS_PORT=9050
HTTP__SSL_VERIFY=true
SCAN__MODULE_TIMEOUT_SECONDS=30
# High-fanout overrides (Maigret/Sherlock/WhatsMyName = 600s) live in ScanSettings.
STORAGE__SCAN_DIR=/app/data/scans
STORAGE__STATE_DIR=/app/data/state
RAHASYA_METRICS_PORT=9108

# Local agent runtime. Enable per scan in the dashboard or with --agentic.
# Inspect with: python -m rahasya brain-info
# Downloaded local models only; no paid API backend or automatic cloud fallback.
# Model availability is not checked by brain-info.
BRAIN__PROVIDER=ollama
BRAIN__ENABLED=false
BRAIN__CONTEXT_LENGTH=4096
BRAIN__MAX_OUTPUT_TOKENS=512
BRAIN__REQUEST_TIMEOUT_SECONDS=120
BRAIN__MAX_MODEL_CALLS=60
BRAIN__MAX_ACTIONS=15
BRAIN__MAX_ACTIONS_PER_ENTITY=3
# Full tool observations are archived; only this many enter the working graph.
BRAIN__MAX_CANDIDATES_PER_TOOL=20
# Docker Desktop application -> Ollama running on the host PC.
# For native Python use http://127.0.0.1:11434 instead.
BRAIN__BASE_URL=http://host.docker.internal:11434
BRAIN__MODELS__COORDINATOR=qwen3:4b
BRAIN__MODELS__REVIEWER=qwen3:4b
BRAIN__MODELS__IDENTITY=qwen3:4b
BRAIN__MODELS__SOCIAL=qwen3:4b
BRAIN__MODELS__EXPOSURE=qwen3:4b
BRAIN__MODELS__DARKWEB=qwen3:4b
BRAIN__MODELS__MEDIA_ARCHIVE=qwen3:4b
BRAIN__MODELS__REPORTER=qwen3:4b

# --------------------------------------------------------------------------
# Optional providers (FIXES_NEW.md §I.3)
#
# Every module labelled "optional" self-skips gracefully when its key is
# missing. The free-tier default set (holehe, ignorant, Gravatar,
# GitHubEmailSearch, HIBP-Passwords, RecoveryHintProbe) requires no keys
# and always runs.
# --------------------------------------------------------------------------

# Optional. Adds named-breach attribution. Without a key, holehe still
# detects the same accounts via a different mechanism, but you lose the
# breach-dataset name.
API_KEYS__HIBP=
# Optional. Adds extra paste / leak dataset coverage on top of HIBP.
API_KEYS__INTELX=
API_KEYS__INTELX_TIER=free
# Optional. Extra leak-dataset coverage.
API_KEYS__LEAKLOOKUP=
# Optional. Enables HunterIOReverse: email → company / co-worker
# candidates (feeds §G related-person expansion).
API_KEYS__HUNTER=

# JSON arrays for rate-limit-aware rotation, e.g. ["key-a","key-b"]
API_KEYS__HIBP_KEYS=[]
API_KEYS__INTELX_KEYS=[]

# --------------------------------------------------------------------------
# GitHub — keyless by default (10 req/min). Set a token to raise the
# rate limit to 30 req/min. Recommended for multi-target or
# related-person scans. (FIXES_NEW.md §E.4, §I.3)
# --------------------------------------------------------------------------
# GITHUB_TOKEN=

# --------------------------------------------------------------------------
# Scan tuning (FIXES_NEW.md §F.2, §F.3, §G.2, §J.2)
# --------------------------------------------------------------------------
# SCAN__MAIGRET_TOP_SITES=500          # 0 = full 3000-site sweep (deep)
# SCAN__WHATSMYNAME_CONCURRENCY=32     # was 150, dropped to reduce failures
# SCAN__MAX_RELATED_PERSONS=3          # hard cap on related-person expansion
# SCAN__MAX_RELATED_DEPTH=1            # related persons never re-expand
# SCAN__MAX_NETWORK_CALLS=5000         # global per-scan HTTP budget
