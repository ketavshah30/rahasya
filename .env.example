# === Database ===
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rahasya

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === API Keys (all optional) ===
HIBP_API_KEY=
INTELX_API_KEY=
DEHASHED_API_KEY=
LEAKLOOKUP_API_KEY=

# === Neo4j (optional) ===
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# === Tor (optional) ===
TOR_SOCKS_PORT=9050
TOR_CONTROL_PORT=9051
TOR_PASSWORD=

# === Scan Limits ===
MAX_RECURSION_DEPTH=3
MAX_ENTITIES=500
MAX_SCAN_MINUTES=30

# === Application ===
LOG_LEVEL=INFO
ENVIRONMENT=development
DEBUG=false
